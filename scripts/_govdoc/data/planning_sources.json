  "tracks": {
    "upper-policy": {
      "label": "上位政策与五年规划",
      "description": "国务院/部委政策文件、五年规划建议与纲要、政府工作报告、政府公报与规范性文件效力核验",
      "dept_keys": ["gov", "fgw"],
      "central_keys": ["gov", "fgw", "law"],
      "query_hints": ["十五五", "十四五", "规划纲要", "政府公报", "规范性文件"],
      "prefer_direct": ["central"]
    },
    "spatial-plan": {
      "label": "国土空间规划与控规详规",
      "description": "国土空间总体规划批复与公开文本、控规/详规草案公示与批后公布、法定图则、用地混合与用途转换",
      "dept_keys": ["pnr", "gov"],
      "central_keys": ["pnr", "gov"],
      "query_hints": ["国土空间", "详细规划", "规划公示", "用地性质", "功能混合"],
      "prefer_direct": ["central", "list"]
    },
    "housing-renewal": {
      "label": "住房保障与城市更新",
      "description": "住房发展规划、保障性住房配租配售公告、城市更新计划与专规公告、老旧小区改造、物业与绿色建筑",
      "dept_keys": ["housing", "pnr", "gov"],
      "central_keys": ["housing", "pnr", "gov"],
      "query_hints": ["城市更新", "保障性住房", "配租", "住房发展", "物业"],
      "prefer_direct": ["central", "list"]
    },
    "land-supply": {
      "label": "土地供应、出让与公共资源",
      "description": "年度建设用地供应计划、土地招拍挂出让公告与成交公示、规划设计条件、基准地价、土地储备与盘活",
      "dept_keys": ["pnr", "ggzy", "gov"],
      "central_keys": ["pnr", "ggzy"],
      "query_hints": ["土地出让", "供地计划", "挂牌出让", "规划设计条件", "土地储备"],
      "prefer_direct": ["list"]
    },
    "stats-census": {
      "label": "统计公报、年鉴与普查",
      "description": "年度统计公报、月/季度经济运行情况、统计年鉴、人口普查公报、经济普查公报、法治政府建设报告",
      "dept_keys": ["stats", "gov"],
      "central_keys": ["stats"],
      "query_hints": ["统计公报", "统计年鉴", "经济运行情况", "人口普查", "经济普查", "法治政府建设"],
      "prefer_direct": ["list"]
    },
    "standards": {
      "label": "国标、行标、地标与技术准则",
